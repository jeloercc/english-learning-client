# Rename this file to .env and fill in your values.

# ─── Backend URL ───────────────────────────────────────────────────────────────
# Development: leave empty or set to http://localhost:3001
# Production:  set to your backend HTTPS domain, e.g. https://api.tu-dominio.com
# VITE_API_URL=https://api.tu-dominio.com

# ─── Progress API Auth ─────────────────────────────────────────────────────────
# Must match PROGRESS_TOKEN in the backend env file.
# Generate a strong random token, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_PROGRESS_TOKEN=your_secret_token_here
